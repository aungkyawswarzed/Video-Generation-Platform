{
  "name": "frame-studio",
  "version": "0.3.0",
  "description": "Frame Studio — Windows AI video production studio",
  "author": "Frame Studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,worker \"next dev --hostname 127.0.0.1\" \"tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/worker.ts\"",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start --hostname 127.0.0.1\" \"tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/worker.ts\"",
    "worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests desktop next.config.ts electron-builder.cjs playwright.config.ts playwright.desktop.config.ts",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:test": "playwright test --config playwright.desktop.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "concurrently": "^9.2.0",
    "file-type": "^21.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "7zip-bin": "^5.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true,
    "electron@44.9.0": true
  }
}
